# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://taneja:taneja@localhost:5432/taneja_dev
# Set to true for managed Postgres that requires TLS.
DATABASE_SSL=false
# Used only by the test suite.
TEST_DATABASE_URL=postgres://taneja:taneja@localhost:5432/taneja_test
# At least 32 random characters. Required in staging/production (e.g. `openssl rand -base64 48`).
# OTP_PEPPER=
# dev_console prints OTPs to the server log. A real SMS/DLT provider is still to be chosen.
SMS_PROVIDER=dev_console
SESSION_TTL_DAYS=30
