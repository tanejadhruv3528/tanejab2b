# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://taneja:taneja@localhost:5432/taneja_dev
# Set to true for managed Postgres that requires TLS.
DATABASE_SSL=false
# Used only by the test suite.
TEST_DATABASE_URL=postgres://taneja:taneja@localhost:5432/taneja_test
